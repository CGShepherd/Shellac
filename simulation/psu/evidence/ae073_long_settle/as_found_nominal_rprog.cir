* Shellac PSU RUN01 nominal P1-V operating-point sweep
.param RSETP_DIAG=2260
.param RSETN_DIAG=2160
.param FLINE=50
.param VSEC=15
.param RSEC=1.41
.param CRES=4700u
.param RESR=0.10
.param CCOUP=33u
.param CCOUP_ESR=1
.param CADJ=22u
.param CADJ_ESR=1
.param COUT=120u
.param COUT_ESR=0.20

* Centre-tapped transformer secondary, T1 on-load nominal representation
VACP AC_P 0 SINE(0 {VSEC*sqrt(2)} {FLINE})
VACN AC_N 0 SINE(0 {-VSEC*sqrt(2)} {FLINE})
RSECP AC_P ACP {RSEC}
RSECN AC_N ACN {RSEC}

* Rectifier surrogate: BYV26E-like fast silicon diode using controlled generic execution model.
* Identity is explicitly surrogate; RUN06 will compare rectifier families.
.model DRECT D(Is=5n Rs=0.08 N=1.8 Cjo=15p M=0.33 Tt=75n Bv=1000 Ibv=5u)
DPP ACP RAWP DRECT
DPN ACN RAWP DRECT
DNP RAWN ACP DRECT
DNN RAWN ACN DRECT
CDPP ACP RAWP 100n
CDPN ACN RAWP 100n
CDNP RAWN ACP 100n
CDNN RAWN ACN 100n

* Reservoirs with explicit ESR
RRESP RAWP PRESP {RESR}
CRESP PRESP 0 {CRES}
RRESN RAWN PRESN {RESR}
CRESN PRESN 0 {CRES}

* Regulator manufacturer models
.include "C:/Users/chris/Dropbox/000_Projects/000_Audio/Shellac/simulation/psu/models/wrappers/lm317_shellac_psu.lib"
.include "C:/Users/chris/Dropbox/000_Projects/000_Audio/Shellac/simulation/psu/models/wrappers/lm337_shellac_psu.lib"

XREGP RAWP ADJP VOUTP SHELLAC_LM317
XREGN RAWN ADJN VOUTN SHELLAC_LM337

* OUT-ADJ resistors, as-fitted 220 ohm nominal
RADJP VOUTP ADJP 220
RADJN VOUTN ADJN 220

* Rubycon RX30 ADJ bypass, polarity represented electrically
RADJESRP ADJP CADJP {CADJ_ESR}
CADJP CADJP 0 {CADJ}
RADJESRN ADJN CADJN {CADJ_ESR}
CADJN 0 CADJN {CADJ}

* LF353 servo

* Positive rail is U1B: +IN=0, -IN receives AC-coupled output error
RCOUPP VOUTP SCP {CCOUP_ESR}
CCOUPP SCP NSP {CCOUP}
RSENP NSP NMP 1k
RFBP OP NMP 33k
CFBP OP NMP 30p
XU1B 0 NMP VOUTP VOUTN OP SHELLAC_LF353
RSETP OP ADJP {RSETP_DIAG}

* Negative rail is U1A
RCOUPN VOUTN SCN {CCOUP_ESR}
CCOUPN SCN NSN {CCOUP}
RSENN NSN NMN 1k
RFBN ON NMN 33k
CFBN ON NMN 30p
XU1A 0 NMN VOUTP VOUTN ON SHELLAC_LF353
RSETN ON ADJN {RSETN_DIAG}

* Output capacitors and 100nF WIMA bypasses
ROUTESRP VOUTP COP {COUT_ESR}
COUTP COP 0 {COUT}
CFILMP VOUTP 0 100n
ROUTESRN VOUTN CON {COUT_ESR}
COUTN 0 CON {COUT}
CFILMN VOUTN 0 100n

* Qualification load, 100mA per rail
RLOADP VOUTP 0 170
RLOADN 0 VOUTN 170

.tran 0 8 0 100u uic







